# Dependencias — se reconstruyen con `npm ci` (versiones exactas en package-lock.json)
node_modules
dist
out
.DS_Store
.env
__pycache__/

# Motor de transcripción — se auto-instala en la 1ª corrida de scripts/transcribe.mjs
# (via @remotion/install-whisper-cpp). No hace falta compartirlo (~3 GB).
whisper.cpp
tmp.json

# Material de cada usuario: videos, ediciones y entregables. Solo se comparten los README.
Crudos/*
!Crudos/README.md
Ediciones/*
!Ediciones/README.md
Terminados/*
!Terminados/README.md

# Marcas: cada usuario guarda las suyas (marca.json, logo, fuentes, portada, cliente ideal).
# Se comparten solo la guía y la marca de ejemplo.
marcas/*
!marcas/README.md
!marcas/ejemplo/

# El Root.tsx de cada video: se crea desde templates/Root.template.tsx (scripts/new_project.sh)
src/Root.tsx

# Local, fuera de la plantilla
_experimentos/
scripts/_*_tmp.py

# Acceso directo public/ediciones → Ediciones/ (lo crea scripts/preparar.sh en cada PC)
public/ediciones
